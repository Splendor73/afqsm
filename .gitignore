# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Node.js frontend
/frontend/node_modules
/frontend/.next
/frontend/out
/frontend/build

# Python backend
/backend/venv/
__pycache__/
*.pyc

# dependencies (legacy, just in case)
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
/frontend/.env*
/backend/.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
/frontend/next-env.d.ts
